# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=development
DEBUG=false

# SQLite (default, zero-config) or PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fabric_catalog
DATABASE_URL=sqlite:///./fabric_catalog.db

# Admin Bearer token. REQUIRED in production: the app refuses to start
# when APP_ENV=production and this is left at the placeholder below.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-long-random-secret

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
INVENTORY_ENABLED=true

# Comma-separated allowed origins. "*" disables credentialed CORS.
# Set explicit origins in production, e.g. https://studio.example.com
CORS_ORIGINS=*

# Per-IP request limit per minute. 0 disables.
RATE_LIMIT_PER_MINUTE=120
