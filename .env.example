# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=development
DEBUG=false

# SQLite (default, zero-config) or PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fabric_catalog
DATABASE_URL=sqlite:///./fabric_catalog.db

# Admin Bearer token. REQUIRED in production: the app refuses to start
# when APP_ENV=production and this is left at the placeholder below.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-long-random-secret

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
INVENTORY_ENABLED=true

# Comma-separated allowed origins. "*" disables credentialed CORS.
# Set explicit origins in production, e.g. https://studio.example.com
CORS_ORIGINS=*

# Per-IP request limit per minute. 0 disables.
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------
# Rate limiting — read this before scaling vertically
# ---------------------------------------------------------------------
# memory = THIS PROCESS ONLY. With N workers the effective limit is
#          roughly N x RATE_LIMIT_PER_MINUTE. Correct for one worker.
# redis  = shared across all workers/replicas using REDIS_URL.
# off    = no limiting.
RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_BACKEND=redis requires this. Credentials in a URL are never logged.
# REDIS_URL=redis://:password@localhost:6379/0
# If Redis is unreachable: true = allow requests, false = 503.
RATE_LIMIT_FAIL_OPEN=true
# Number of reverse proxies that overwrite X-Forwarded-For.
# 0 = ignore the header (prevents clients spoofing it to dodge limits).
TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------------
# Backend-to-backend auth (other modules -> Module 02)
# ---------------------------------------------------------------------
# NEVER give these to a browser. Each module gets its own key.
# SERVICE_API_KEYS=module01:replace-with-long-random-secret
# Scopes: catalog:read, catalog:write, inventory:read, inventory:write, supplier:read
# SERVICE_KEY_SCOPES=module01:catalog:read+inventory:write
# Optional IP allowlist for service keys (comma separated).
# SERVICE_ALLOWED_IPS=
