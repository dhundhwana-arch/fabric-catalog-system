# Copy to .env and fill in real values. NEVER commit .env.
APP_ENV=development
DEBUG=false

# SQLite (default, zero-config) or PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fabric_catalog
DATABASE_URL=sqlite:///./fabric_catalog.db

# Admin Bearer token — generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=dev-only-change-me

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
INVENTORY_ENABLED=true
CORS_ORIGINS=*
